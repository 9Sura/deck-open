# Supabase (Phase 4a accounts). Copy to `.env.local` and fill in from your
# Supabase project's Settings → API. Until these are set, the app runs in
# guest-only mode with zero network — no auth UI appears.

# Public, RLS-protected — safe to ship to the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-ONLY (Settings → API → service_role). Used by app/account/delete for
# account deletion via auth.admin.deleteUser. NEVER expose to the client — it
# bypasses RLS. Without it, everything works except "Delete account".
SUPABASE_SERVICE_ROLE_KEY=
